{
  "name": "devquest",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A cozy programming RPG. Your first day at PixelByte starts here.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs --production",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "desktop:build": "node scripts/build-macos.mjs",
    "java:build": "docker build -t devquest-java:local server/java",
    "format": "prettier --write src server tests scripts vite.config.ts .github README.md CONTRIBUTING.md CHANGELOG.md docs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.15.29",
    "typescript": "5.9.3",
    "vite": "7.1.3",
    "prettier": "3.6.2"
  },
  "overrides": {
    "rollup": "4.53.3"
  }
}
